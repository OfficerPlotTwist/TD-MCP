{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__touchdesigner__(set_par_value|create_operator|execute_script)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/nik/Documents/AI/MCP/TD MCP/.claude/td-expressive-hook.js\"",
            "timeout": 10,
            "statusMessage": "TD expressive reminder"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__touchdesigner__(execute_script|set_par_value|create_operator|connect_operators|disconnect_operators|delete_operator)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/nik/Documents/AI/MCP/TD MCP/.claude/td-autosave-hook.js\"",
            "timeout": 10,
            "async": true,
            "statusMessage": "TD auto-save"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/nik/Documents/AI/MCP/TD MCP/.claude/td-autosave-hook.js\" --force",
            "timeout": 10,
            "statusMessage": "TD save (end of turn)"
          },
          {
            "type": "command",
            "command": "node \"C:/Users/nik/Documents/AI/MCP/TD MCP/.claude/td-action-hook.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
